# Copy to backend/.env.

# --- Auth: Clerk (https://clerk.com). Create an application, copy its publishable key. ---
# The backend derives everything it needs to verify sessions from this public key.
ATRIUM_CLERK_PUBLISHABLE_KEY=pk_test_...
# Local development without login (never set this on a deployed server):
# ATRIUM_DEV_AUTH=1

# --- Encryption key for users' OpenRouter keys at rest. Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it makes saved keys unreadable (users just re-enter them).
ATRIUM_SECRET_KEY=

# --- Database. Default is a SQLite file in backend/data (fine locally, single server only).
# For production use Postgres; hosted free tiers (Neon, Supabase) need no Docker:
# ATRIUM_DATABASE_URL=postgresql://user:password@host/dbname

# --- Default OpenRouter model per tier (each user can override in Settings) ---
# ATRIUM_TIER_FAST=anthropic/claude-haiku-5.5
# ATRIUM_TIER_BALANCED=anthropic/claude-sonnet-5.5
# ATRIUM_TIER_SMART=anthropic/claude-opus-5.5

# --- Embeddings for knowledge boxes: an OpenRouter embedding model, or "local" (offline, lexical) ---
# ATRIUM_EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Langfuse (tracing, scores, experiments, prompt management). Leave unset to run untraced ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Misc ---
# ATRIUM_ORCHESTRATOR_NAME=Jarvis
# ATRIUM_ALLOWED_ORIGINS=http://localhost:5173

# Model provider keys are NOT configured here: each user adds their own OpenRouter key in the app.
# The eval scripts read OPENROUTER_API_KEY from the environment when you run them.
